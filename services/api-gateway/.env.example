# api-gateway 专属 .env 模板
#
# 复制为 services/api-gateway/.env 后填写本地值（该文件已被 .gitignore 忽略）。
# 本文件中的同名变量会覆盖仓库根目录 .env 的对应值。
#
# 读取优先级：系统环境变量 > 本文件（服务自身 .env）> 仓库根 .env > 默认值
#
# 通常只需覆盖与本地环境不同的项，其余沿用根 .env 的默认值即可。
# 例如修改网关端口或前端来源时改这两项：
# GATEWAY_PORT=5001
# GATEWAY_ALLOW_ORIGINS=http://localhost:5173

# ---- 服务基础配置（GATEWAY_ 前缀）----
# GATEWAY_PORT            HTTP 监听端口，默认 5001
# GATEWAY_USER_SERVICE_URL  user-service gRPC 地址，默认 localhost:5002
# GATEWAY_ALLOW_ORIGINS   CORS 允许的来源（逗号分隔），默认 http://localhost:5173
# GATEWAY_COOKIE_SECURE    Cookie 是否仅 HTTPS 传输，默认 false（生产置 true）
# GATEWAY_COOKIE_SAMESITE Cookie SameSite 策略: lax/strict/none，默认 lax
# GATEWAY_COOKIE_DOMAIN   Cookie 作用域（留空表示当前域），默认 ""
# GATEWAY_PORT=5001
# GATEWAY_USER_SERVICE_URL=localhost:5002
# GATEWAY_ALLOW_ORIGINS=http://localhost:5173
# GATEWAY_COOKIE_SECURE=false
# GATEWAY_COOKIE_SAMESITE=lax
# GATEWAY_COOKIE_DOMAIN=

# ---- 共享密钥（无前缀，与 user-service 共用）----
# JWT_SECRET  用于本地验签 access/refresh token，必填；缺失则网关启动失败
JWT_SECRET=

# ---- 日志配置（LOG_ 前缀）----
# LOG_LEVEL        日志级别: debug/info/warn/error，默认 info
# LOG_FORMAT       日志格式: json/console，默认 json
# LOG_OUTPUT_PATH  文件日志输出目录，默认 ./logs
# LOG_SERVICE_NAME  日志中标识的服务名，默认 api-gateway
# LOG_CONSOLE      是否同时输出到控制台，默认 true
# LOG_COMPRESS     是否压缩历史日志，默认 true
# LOG_MAX_SIZE     单文件最大体积（MB），默认 0（不限制）
# LOG_MAX_BACKUPS  最大备份数，默认 0（不限制）
# LOG_MAX_AGE      日志最长保留天数，默认 0（不限制）
# LOG_LEVEL=info
# LOG_FORMAT=json
# LOG_OUTPUT_PATH=./logs
# LOG_SERVICE_NAME=api-gateway
# LOG_CONSOLE=true
# LOG_COMPRESS=true
# LOG_MAX_SIZE=0
# LOG_MAX_BACKUPS=0
# LOG_MAX_AGE=0
