# ============================================================
# crawl4ai-service 环境变量样例（HTTP + gRPC 双接口版）
# 复制为 .env 后按需修改。
#
# 本服务**不在环境变量中保存任何 LLM 凭证**，
# LLM 凭证（api_key / base_url / model 等）由调用方在
# 每次 Extract 调用的 ``llm`` 字段中传入。
# ============================================================

# ---- 服务基础 ----
# 同一个服务提供两套接口，共用同一份爬取 / 提取核心逻辑：
#   * HTTP（FastAPI，带 Swagger UI）
#   * gRPC（proto/crawl 契约）
# 两个版本共用同一个监听端口；跑哪个版本由打包时装的依赖组决定
# （见 pyproject.toml 的 http/grpc 组），无需开关。
PORT=5003

# ---- API Key 认证 ----
# 留空时禁用认证（仅供本地开发）。
# 生产环境必须设置，Health/Crawl/Extract 调用方需携带 Authorization 头。
API_KEY=crawl4ai-service-api-key

# ---- 爬虫行为 ----
DEFAULT_MAX_CONCURRENT=5
DEFAULT_TIMEOUT=60
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=2.0
RESPECT_ROBOTS_TXT=true
ENABLE_STEALTH=true
HEADLESS=true

# ---- 浏览器二进制 ----
# 留空时使用 Playwright 自带的 Chromium。
# 若主机是 Playwright 尚未提供 chromium 包的 Linux 发行版
# （典型如 Ubuntu 26.04：``playwright install`` 报
# ``Playwright does not support chromium on ubuntu26.04-x64``），
# 可指向系统已安装的 Chrome 二进制：
#   BROWSER_EXECUTABLE_PATH=/usr/bin/google-chrome
#   BROWSER_TYPE=chrome
BROWSER_EXECUTABLE_PATH=
BROWSER_TYPE=chrome
