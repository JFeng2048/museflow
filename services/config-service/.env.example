# ============================================================
# config-service 配置示例（gRPC，建议端口 5004）
# ------------------------------------------------------------
# 约定见 AGENTS.md：服务专属键用 CONFIG_ 前缀（env.Get）；
# 共享键无前缀（DB_* / MODEL_SECRET_KEY，env.GetCommon）。
# 复制为 .env 后按环境修改；.env 不入库，勿提交真实密钥。
# ============================================================

# ---- 服务专属 ----
# gRPC 监听端口（与 api-gateway 的 GATEWAY_MODEL_SERVICE_URL 对应）
CONFIG_PORT=5004
# 日志统一输出到 stdout，由容器运行时 / k8s 收集，不落盘
LOG_LEVEL=info
LOG_FORMAT=json
LOG_CONSOLE=true

# ---- 模型凭证加密密钥（共享键，无前缀）----
# AES-256-GCM 主密钥，须为 32 字节。用于加密 model_provider.api_key、
# user_model_provider.api_key 与 system_setting.secret_value。
# 生成方式：openssl rand -hex 16
# 【务必】与 user-service 的 JWT_SECRET 一样集中放在 overlays/secrets.yaml，
# 切勿提交到仓库；一旦变更，历史密文将全部无法解密。
MODEL_SECRET_KEY=change-me-generate-a-32-byte-secret

# ---- PostgreSQL（共享 DB_*，由这些变量拼装连接串）----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=museflow
