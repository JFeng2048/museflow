# user-service 专属 .env 模板
#
# 复制为 services/user-service/.env 后填写本地值（该文件已被 .gitignore 忽略）。
# 本文件中的同名变量会覆盖仓库根目录 .env 的对应值。
#
# 读取优先级：系统环境变量 > 本文件（服务自身 .env）> 仓库根 .env > 默认值
#
# 通常只需覆盖与本地环境不同的项，其余沿用根 .env 的默认值即可。
# 例如独立用户库时改这两项：
# DB_NAME=museflow_user

# 以下为可选覆盖示例（默认注释掉，沿用根 .env）：
# USER_PORT=5002
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=password
# DB_NAME=museflow
# REDIS_ADDR=localhost:6379

# ---- 验证码（密码重置）----
# USER_CODE_TTL_SECONDS          验证码有效期（秒），默认 600（10 分钟）
# USER_CODE_LENGTH               验证码位数，默认 6
# USER_CODE_RESEND_COOLDOWN_SECONDS  重发冷却（秒），默认 60
# USER_CODE_TTL_SECONDS=600
# USER_CODE_LENGTH=6
# USER_CODE_RESEND_COOLDOWN_SECONDS=60

# ---- 邮件发送（SMTP）----
# 未配置 USER_SMTP_HOST 时降级为「日志模式」：验证码只写入日志，不真实发信，
# 便于本地联调走通完整流程。生产环境请配置以下 SMTP 参数。
# 端口 465 走隐式 TLS，其余端口尝试 STARTTLS 升级。
# USER_SMTP_HOST=smtp.example.com
# USER_SMTP_PORT=587
# USER_SMTP_USERNAME=noreply@museflow.ai
# USER_SMTP_PASSWORD=your-smtp-password
# USER_SMTP_FROM=noreply@museflow.ai

# ---- 异步任务队列（asynq，消费端为 cmd/worker）----
# 邮件发送已改为异步：gRPC 服务只入队，由独立 Worker 进程并发消费。
# 队列复用公共 REDIS_* 配置，不单独指定连接。
# USER_QUEUE_NAME                  队列名，默认 email
# USER_QUEUE_MAX_RETRY             失败最大重试次数，默认 3
# USER_QUEUE_TIMEOUT_SECONDS       单个任务执行超时（秒），默认 30
# USER_QUEUE_RETENTION_SECONDS     已完成任务保留时长（秒），默认 3600
# USER_QUEUE_STATUS_TTL_SECONDS    任务进度保留时长（秒），影响客户端可订阅的窗口，默认 600
# USER_WORKER_CONCURRENCY          Worker 并发数，决定发信吞吐，默认 20
# USER_QUEUE_NAME=email
# USER_QUEUE_MAX_RETRY=3
# USER_QUEUE_TIMEOUT_SECONDS=30
# USER_QUEUE_RETENTION_SECONDS=3600
# USER_QUEUE_STATUS_TTL_SECONDS=600
# USER_WORKER_CONCURRENCY=20

# ---- 双因素认证（2FA / TOTP）----
# MFA_TICKET_TTL_SECONDS       登录第一步到第二步的中间票据有效期（秒），默认 300
# MFA_ISSUER                    验证器 App 中展示的发行方名称，默认 MuseFlow
# MFA_SKEW                      允许的时钟偏移步数（每步 30 秒），默认 1
# MFA_RECOVERY_CODE_COUNT       恢复码数量，默认 8
# MFA_RECOVERY_CODE_LENGTH      单个恢复码长度，默认 10
# MFA_TICKET_TTL_SECONDS=300
# MFA_ISSUER=MuseFlow
# MFA_SKEW=1
# MFA_RECOVERY_CODE_COUNT=8
# MFA_RECOVERY_CODE_LENGTH=10
