# user-service 专属 .env 模板
#
# 复制为 services/user-service/.env 后填写本地值（该文件已被 .gitignore 忽略）。
# 本文件中的同名变量会覆盖仓库根目录 .env 的对应值。
#
# 读取优先级：系统环境变量 > 本文件（服务自身 .env）> 仓库根 .env > 默认值
#
# 通常只需覆盖与本地环境不同的项，其余沿用根 .env 的默认值即可。
# 例如独立用户库时改这两项：
# DB_NAME=museflow_user

# 以下为可选覆盖示例（默认注释掉，沿用根 .env）：
# USER_PORT=5002
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=password
# DB_NAME=museflow
# REDIS_ADDR=localhost:6379

# ---- 验证码（密码重置）----
# USER_CODE_TTL_SECONDS          验证码有效期（秒），默认 600（10 分钟）
# USER_CODE_LENGTH               验证码位数，默认 6
# USER_CODE_RESEND_COOLDOWN_SECONDS  重发冷却（秒），默认 60
# USER_CODE_TTL_SECONDS=600
# USER_CODE_LENGTH=6
# USER_CODE_RESEND_COOLDOWN_SECONDS=60

# ---- 邮件发送（SMTP）----
# 未配置 USER_SMTP_HOST 时降级为「日志模式」：验证码只写入日志，不真实发信，
# 便于本地联调走通完整流程。生产环境请配置以下 SMTP 参数。
# USER_SMTP_HOST=smtp.example.com
# USER_SMTP_PORT=587
# USER_SMTP_USERNAME=noreply@museflow.ai
# USER_SMTP_PASSWORD=your-smtp-password
# USER_SMTP_FROM=noreply@museflow.ai
