# 开发环境变量（复制为 .env.development 后生效）
VITE_APP_TITLE=MuseFlow

# 网关全局路由前缀（services/api-gateway/internal/router/router.go 中的 /api/v1）
VITE_API_BASE_URL=/api/v1

# 人机验证降级开关（仅本地调试用）。为 true 时，Turnstile 脚本加载失败或站点密钥为空
# 仍允许登录/注册提交，等于跳过人机校验；生产环境必须保持 false。
# 它与页面上的「演示数据」标注无关——那只是说明该页数据来自本地 @/mock。
VITE_ALLOW_CAPTCHA_FALLBACK=false

# Cloudflare Turnstile 站点密钥（Site Key，公开值，仅前端使用）。
# 服务端密钥是 USER_TURNSTILE_SECRET，两者不是同一个值，切勿把 Secret 写到这里。
VITE_TURNSTILE_SITE_KEY=
