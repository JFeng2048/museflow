# 开发环境变量（复制为 .env.development 后生效）
VITE_APP_TITLE=MuseFlow

# 网关全局路由前缀（services/api-gateway/internal/router/router.go 中的 /api/v1）
VITE_API_BASE_URL=/api/v1

# 认证/用户/管理后台的数据 mock 已删除，与此开关无关。它现在只影响两处：
#   1) 顶栏是否显示 MOCK 角标
#   2) 登录/注册的人机验证是否允许失败降级（true = 跳过校验）
# 生产环境必须保持 false。对接现状详见 web/docs/README.md
VITE_ENABLE_MOCK=false
