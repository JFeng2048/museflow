# MuseFlow 本地开发配置示例
#
# 复制为仓库根目录的 .env 后填写本地值（.env 已被 .gitignore 忽略，不提交）。
# 按服务前缀区分：
#   GATEWAY_  前缀 -> api-gateway
#   USER_     前缀 -> user-service
#
# 优先级：系统环境变量 > .env 文件 > 代码默认值

# ============ API Gateway ============
GATEWAY_PORT=5001
GATEWAY_USER_SERVICE_URL=localhost:5002
GATEWAY_ALLOW_ORIGINS=http://localhost:5173
GATEWAY_COOKIE_SECURE=false
GATEWAY_COOKIE_SAMESITE=lax
GATEWAY_COOKIE_DOMAIN=
GATEWAY_GIN_MODE=

# ============ 数据库（公共配置，所有服务共用） ============
# 放在根 .env 作为公共默认值；如需覆盖，可在服务自身 .env 中重设。
# 读取优先级：系统环境变量 > 服务自身 .env > 仓库根 .env > 默认值
DB_HOST=localhost
DB_PORT=5432
DB_USER=museflow
DB_PASSWORD=museflow
DB_NAME=museflow

# ============ JWT 共享密钥（gateway 与 user-service 共用，用于验签） ============
JWT_SECRET=change-me-in-prod

# ============ Redis（公共配置，所有服务共用） ============
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=museflow
REDIS_DB=0

# ============ User Service ============
USER_PORT=5002
USER_ACCESS_TTL_SECONDS=3600
USER_REFRESH_TTL_SECONDS=2592000
USER_BCRYPT_COST=10

# ---- 邮件发送（SMTP，由 user-service worker 使用） ----
# 未配置时降级为「日志模式」：邮件内容只写入日志，不真实发信
USER_SMTP_HOST=
USER_SMTP_PORT=587
USER_SMTP_USERNAME=
USER_SMTP_PASSWORD=
USER_SMTP_FROM=

# ---- 人机验证（Cloudflare Turnstile）----
# 保护发送邮箱验证码等易被脚本刷的接口。
#
# 【重要】USER_TURNSTILE_SECRET 是服务端机密，只允许写进 .env 或环境变量，
#         严禁提交到仓库、严禁下发到前端。前端只需要站点密钥（公开值）。
#
# 未配置时人机验证降级为「跳过」，接口不受保护，服务启动会告警；生产环境必须配置。
# 填 Secret Key（服务端），不要填 Site Key。前端站点密钥走 web 的 VITE_TURNSTILE_SITE_KEY。
USER_TURNSTILE_SECRET=
USER_TURNSTILE_ENDPOINT=https://challenges.cloudflare.com/turnstile/v0/siteverify
USER_TURNSTILE_TIMEOUT_SECONDS=15
# 来源域名白名单，逗号分隔；留空表示不校验 hostname
USER_TURNSTILE_ALLOWED_HOSTNAMES=

# ---- 异步任务队列（asynq，消费端为 user-service worker） ----
# 队列与任务进度共用上面的公共 Redis 配置
USER_QUEUE_NAME=email
USER_QUEUE_MAX_RETRY=3
USER_QUEUE_TIMEOUT_SECONDS=30
USER_QUEUE_RETENTION_SECONDS=3600
USER_QUEUE_STATUS_TTL_SECONDS=600
USER_WORKER_CONCURRENCY=20

# ============ 日志（LOG_ 前缀，所有服务共用） ============
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT_PATH=./logs
LOG_SERVICE_NAME=
LOG_CONSOLE=true
LOG_MAX_SIZE=0
LOG_MAX_BACKUPS=0
LOG_MAX_AGE=0
LOG_COMPRESS=true
